{
  "expo": {
    "name": "TabUp",
    "slug": "TabUp",
    "scheme": "tabup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/dark-mode/TabUp-Light-Trans.png",
        "resizeMode": "contain",
        "backgroundColor": "#0a1918"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tabup.us",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:tabup.cslade.space"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.camdenslade.TabUp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "630711da-097f-4202-808a-521490cfb586"
      }
    },
    "owner": "camdenslade"
  }
}
